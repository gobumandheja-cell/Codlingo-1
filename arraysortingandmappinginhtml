<HTML>
    <head>
        <TITLE>My Playlist Sorter</TITLE>
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
        <style>
            h1, h3 { color: darkviolet; }
            .box { background: white; color: darkviolet; }
        </style>
    </head>
    <body>
        
        <div class="container py-4">

            <h1 class="mb-1">My Playest Sorter</h1>
            <p class="text-muted mb-4">Sort and label your music playlist using JavaScript array methods!</p>

            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="card-title">Song Names</h3>
                   
                    <div id="nameResult" class="box p-3 mt-3 rounded"></div>
                    <div id="nameResult1" class="box p-3 mt-3 rounded"></div>
                    <div id="countResult" class="box p-3 rounded"></div>
                    <div id="countResult1" class="box p-3 rounded"></div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="card-title">Label Every Play Count </h3>
                        <div id="labelResult" class="box p-3 mt-3 rounded"></div>
            </div>
        </div>

        </div>
        <script>
            var songs = ["Zoom", "Bounce", "Glow", "Rush", "Spark"];
            var plays = [320, 85, 210, 50, 175];

            songs.sort();
            document.getElementById("nameResult").innerHTML = "A to Z" + songs;
            songs.sort();
            songs.reverse();
            document.getElementById("nameResult1").innerHTML = "Z to A" + songs;
            plays.sort(function(a,b){return a-b;});
            document.getElementById("countResult").innerHTML = "Least played first: " + plays;
            plays.sort(function(a,b){return b-a;}); document.getElementById("countResult1").innerHTML = "Most played first: " + plays;
            var l = plays.map(function(c) {return c+ "plays";});
            document.getElementById("labelResult").innerHTML = "Labelled: " + l;
        </script>
    </body>
</HTML>